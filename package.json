{
	"name": "svelte-uikit-components",
	"version": "0.22.0",
	"license": "MIT",
	"author": {
		"name": "Wigtertainment Ltd",
		"email": "info@Wigtertainment.ltd",
		"url": "https://Wigtertainment.ltd"
	},
	"repository": {
		"url": "https://github.com/Wigtertainment/svelte-uikit-components"
	},
	"homepage": "https://svelte-uikit.wigtertainment.com",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run package",
		"build:site": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepublishOnly": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretty": "prettier --write \"./**/*.{js,ts}\""
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.57.3",
		"uikit": "^3.25.31"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"prettier": "^3.9.10",
		"publint": "^0.3.25",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.7"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"dependencies": {
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-highlight": "^7.23.1"
	},
	"keywords": [
		"svelte",
		"sveltejs",
		"uikit",
		"components",
		"lib",
		"library",
		"typescript",
		"sveltekit"
	]
}
